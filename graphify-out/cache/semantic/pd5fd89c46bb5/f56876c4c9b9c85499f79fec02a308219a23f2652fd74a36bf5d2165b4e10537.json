{"nodes": [{"id": "how_long_until_dice_match_explained", "label": "explained.md", "file_type": "document", "source_file": "how-long-until-dice-match/explained.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "how_long_until_dice_match_explained_dice_matching_experiment", "label": "Dice matching experiment", "file_type": "concept", "source_file": "how-long-until-dice-match/explained.md", "source_location": "L13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built to develop intuition about randomness: observe exponential probability effects, visualize variance and outliers, and practice logging and post-analysis."}, {"id": "how_long_until_dice_match_explained_all_dice_match_condition", "label": "All-dice-match condition", "file_type": "rationale", "source_file": "how-long-until-dice-match/explained.md", "source_location": "L58", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "how_long_until_dice_match_explained_expected_iterations", "label": "Expected iterations 6^(n\u22121)", "file_type": "rationale", "source_file": "how-long-until-dice-match/explained.md", "source_location": "L132", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single roll matches with probability 6 \u00d7 (1/6)^n = 1/6^(n\u22121), so the expected count explodes with n: 1, 6, 36, 216, 1,296 for five dice, about 10 million for ten."}, {"id": "how_long_until_dice_match_explained_geometric_distribution", "label": "Geometric distribution", "file_type": "rationale", "source_file": "how-long-until-dice-match/explained.md", "source_location": "L159", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Iterations until a match are geometric: long right tails, large max/min gaps and unstable averages for small sample sizes."}, {"id": "how_long_until_dice_match_explained_expected_value_vs_typical_experience", "label": "Expected value \u2260 typical experience", "file_type": "rationale", "source_file": "how-long-until-dice-match/explained.md", "source_location": "L240", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "how_long_until_dice_match_explained_log_file_format", "label": "Per-run log file format", "file_type": "rationale", "source_file": "how-long-until-dice-match/explained.md", "source_location": "L76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each run writes {num_dice}die_{num_runs}sim_{date_time}.txt with metadata, every roll and the matching iteration, so runs are auditable, debuggable and re-analyzable."}, {"id": "how_long_until_dice_match_explained_observability_over_efficiency", "label": "Observability over efficiency", "file_type": "rationale", "source_file": "how-long-until-dice-match/explained.md", "source_location": "L191", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Intentionally inefficient but transparent: logging every roll costs O(n \u00d7 k) time and unbounded log size, accepted because the goal is seeing randomness, not speed."}, {"id": "how_long_until_dice_match_charts", "label": "charts.ipynb", "file_type": "code", "source_file": "how-long-until-dice-match/explained.md", "source_location": "L100", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separates data generation (main.py) from analysis and intuition building: regex-parses logs into a pandas DataFrame for histogram, volatility line, boxplot and cap-hit scatter plots."}], "edges": [{"source": "how_long_until_dice_match_explained", "target": "how_long_until_dice_match_explained_dice_matching_experiment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "how-long-until-dice-match/explained.md", "source_location": "L1", "weight": 1