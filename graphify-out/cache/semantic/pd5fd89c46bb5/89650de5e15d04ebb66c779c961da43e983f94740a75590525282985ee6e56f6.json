{"nodes": [{"id": "brag_output_composition_agents", "label": "AGENTS.md", "file_type": "document", "source_file": "brag-output/composition/AGENTS.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brag_output_composition_agents_hyperframes_skill_router", "label": "/hyperframes skill router", "file_type": "concept", "source_file": "brag-output/composition/AGENTS.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skills encode framework-specific patterns (window.__timelines registration, data-* semantics, shader-compatible CSS) missing from generic web docs; skipping them produces broken compositions."}, {"id": "brag_output_composition_agents_background_preview", "label": "Agent-safe background preview", "file_type": "rationale", "source_file": "brag-output/composition/AGENTS.md", "source_location": "L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A run_in_background wrapper around npm run dev stays owned by the invoking session and can vanish while the browser stays open, so agents use npx hyperframes preview --background and stop it explicitly."}, {"id": "brag_output_composition_agents_pinned_cli_version", "label": "Pinned hyperframes CLI version", "file_type": "rationale", "source_file": "brag-output/composition/AGENTS.md", "source_location": "L58", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scripts pin an exact hyperframes@X.Y.Z so the project re-renders identically over time; upgrades go through npx hyperframes@latest upgrade."}, {"id": "brag_output_composition_agents_timed_clip_rule", "label": "Timed clip rule (data-start + .clip)", "file_type": "rationale", "source_file": "brag-output/composition/AGENTS.md", "source_location": "L95", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "data-start is what marks an element as timed and the shared .clip CSS gives a scene its full-frame box; data-track-index is only a Studio display lane."}, {"id": "brag_output_composition_agents_paused_root_timeline_rule", "label": "Paused root timeline on window.__timelines", "file_type": "rationale", "source_file": "brag-output/composition/AGENTS.md", "source_location": "L97", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The runtime seeks one registered paused root timeline; child scene timelines must not be paused, because a paused child does not advance when the root is seeked."}, {"id": "brag_output_composition_agents_deterministic_logic_rule", "label": "Deterministic logic only", "file_type": "rationale", "source_file": "brag-output/composition/AGENTS.md", "source_location": "L107", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Renders must reproduce frame by frame, so no Date.now(), no Math.random() and no network fetches."}], "edges": [{"source": "brag_output_composition_agents", "target": "readme_hyperframes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brag-output/composition/AGENTS.md", "source_location": "L1", "weight": 1.0}, {"source": "brag_output_composition_agents_hyperframes_skill_router", "target": "readme_hyperframes", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brag-output/composition/AGENTS.md", "source_location": "L7", "weight": 1.0}, {"source": "brag_output_composition_agents", "target": "brag_output_composition_index", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brag-output/composition/AGENTS.md", "source_location": "L78", "weight": 1.0}, {"source": "brag_output_composition_agents", "target": "brag_output_composition_package_scripts_check", "relation": "references", "confidence": "EXTRACTED", "con