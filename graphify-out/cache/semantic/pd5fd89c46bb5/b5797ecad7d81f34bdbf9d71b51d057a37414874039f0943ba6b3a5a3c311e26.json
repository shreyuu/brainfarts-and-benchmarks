{"nodes": [{"id": "readme", "label": "README.md", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_brainfarts_and_benchmarks", "label": "brainfarts-and-benchmarks", "file_type": "concept", "source_file": "README.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small curiosity-driven questions would otherwise disappear; each one ends as runnable code plus a write-up of what was tested and learned."}, {"id": "readme_one_question_per_folder", "label": "One question per folder", "file_type": "rationale", "source_file": "README.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Experiments stay self-contained, with no shared code between them."}, {"id": "readme_measure_dont_assume", "label": "Measure, don't assume", "file_type": "rationale", "source_file": "README.md", "source_location": "L30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claims come from runs, logs and tests, not intuition."}, {"id": "readme_show_the_work", "label": "Show the work", "file_type": "rationale", "source_file": "README.md", "source_location": "L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every experiment ships an explained.md with the method, the numbers and the takeaway."}, {"id": "readme_assert_correctness_report_speed", "label": "Assert correctness, report speed", "file_type": "rationale", "source_file": "README.md", "source_location": "L32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timings depend on the machine and Python version, so benchmarks never fail a test for being slow; numbers are reported, never asserted."}, {"id": "readme_adding_an_experiment", "label": "Adding an e