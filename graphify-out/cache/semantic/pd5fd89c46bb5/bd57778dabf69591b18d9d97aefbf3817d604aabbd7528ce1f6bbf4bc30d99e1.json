{"nodes": [{"id": "why_is_list_multiply_faster_explained", "label": "explained.md", "file_type": "document", "source_file": "why_is_list_multiply_faster/explained.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "why_is_list_multiply_faster_explained_list_multiply_experiment", "label": "list * 2 vs list + list experiment", "file_type": "concept", "source_file": "why_is_list_multiply_faster/explained.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built to understand how identical results can have different costs, build intuition about Python internals and practice robust tests without overengineering."}, {"id": "why_is_list_multiply_faster_explained_correctness_guarantees", "label": "Correctness guarantees", "file_type": "rationale", "source_file": "why_is_list_multiply_faster/explained.md", "source_location": "L63", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "why_is_list_multiply_faster_explained_visible_hidden_cases", "label": "LeetCode-style visible/hidden cases", "file_type": "rationale", "source_file": "why_is_list_multiply_faster/explained.md", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only n = 0, 1, 2, 5, 10, 50, 100 are timed and printed; the other 94 sizes run silently as hidden correctness cases, keeping output readable."}, {"id": "why_is_list_multiply_faster_explained_averaged_timing", "label": "Averaged timing (5,000 repeats)", "file_type": "rationale", "source_file": "why_is_list_multiply_faster/explained.md", "source_location": "L81", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Averaging 5,000 calls per method and never asserting on time avoids timing a single call or requiring one method to always win."}, {"id": "why_is_list_multiply_faster_explained_timing_summary_table", "label": "Visible-case timing summary table", "file_type": "concept", "source_file": "why_is_list_multiply_faster/explained.md", "source_location": "L107", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "why_is_list_multiply_faster_explained_call_overhead_small_inputs", "label": "Call overhead dominates tiny lists", "file_type": "rationale", "source_file": "why_is_list_multiply_faster/explained.md", "source_location": "L126", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For n = 0..5, function-call and loop overhead plus CPU noise dominate, so results flip and plus can win; the list-copy cost only dominates for larger inputs."}, {"id": "why_is_list_multiply_faster_explained_cpython_single_allocation", "label": "CPython single allocation for list * 2", "file_type": "rationale", "source_file": "why_is_list_multiply_faster/explained.md", "source_location": "L161", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "list * 2 knows the final size, allocates once and copies references in a tight loop, while list + list builds its result with slightly more overhead."}, {"id": "why_is_list_multiply_faster_explained_getsizeof_container_check", "label": "sys.getsizeof container check", "file_type": "rationale", "source_file": "why_is_list_multiply_faster/explained.md", "source_location": "L180", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "getsizeof measures only the list container, not the elements, so it only sanity-checks that output grows with input; true space reasoning stays conceptual O(n)."}, {"id": "why_is_list_multiply_faster_explained_same_result_not_same_cost", "label": "Same result \u2260 same cost", "file_type": "rationale", "source_file": "why_is_list_multiply_faster/explained.md", "source_location": "L238", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Both approaches are O(n) in time and space; the gap is constant factors, so Big-O \u2260 real-world performance."}], "edges": [{"source": "why_is_list_multiply_faster_explained", "target": "why_is_list_multiply_faster_explained_list_multiply_experiment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "why_is_list_multiply_faster/explained.md", "source_location": "L1", "weight": 1.0}, {"source": "why_is_list_multiply_faster_experiment_plus_way", "target": "why_is_list_multiply_faster_explained_list_multiply_experiment", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "why_is_list_multiply_faster/explained.md", "source_location": "L40", "weight": 1.0}, {"source": "why_is_list_multiply_faster_experiment_multiply_way", "target": "why_is_list_multiply_faster_explained_list_multiply_experiment", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "why_is_list_multiply_faster/explained.md", "source_location": "L43", "weight": 1.0}, {"source": "why_is_list_multiply_faster_explained_cpython_single_allocation", "target": "why_is_list_multiply_faster_explained_list_multiply_experiment", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "why_is_list_multiply_faster/explained.md", "source_location": "L161", "weight": 1.0}, {"source": "why_is_list_multiply_faster_explained_list_multiply_experiment", "target": "why_is_list_multiply_faster_explained_same_result_not_same_cost", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "why_is_list_multiply_faster/explained.md", "source_location": "L238", "weight": 1.0}, {"source": "why_is_list_multiply_faster_explained_list_multiply_experiment", "target": "why_is_list_multiply_faster_explained_correctness_guarantees", "relation": "conceptually_related_to", "confidence": "EXTRACTE